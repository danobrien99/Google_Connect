GOOGLE_CONNECT_EKG_BASE_URL=http://127.0.0.1:8000
GOOGLE_CONNECT_EKG_WEBHOOK_SECRET=
GOOGLE_CONNECT_RUNTIME_ROOT=
GOOGLE_CONNECT_GOOGLE_CREDENTIALS_PATH=
GOOGLE_CONNECT_GOOGLE_TOKEN_PATH=state/google-token.json

## Choose scope (pick one and delete the other)
## Read Only Scopes
GOOGLE_CONNECT_GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/spreadsheets.readonly,https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/tasks.readonly
## Read and Write Scopes (Gmail send/compose scopes remain forbidden by policy)
GOOGLE_CONNECT_GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar,https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/tasks
GOOGLE_CONNECT_SHEETS_SPREADSHEET_ID=
GOOGLE_CONNECT_SHEETS_CONTACTS_RANGE=Contacts!A:Z
GOOGLE_CONNECT_SHEETS_DEALS_RANGE=Deals!A:Z
GOOGLE_CONNECT_GMAIL_USER_ID=me
GOOGLE_CONNECT_CALENDAR_ID=primary
GOOGLE_CONNECT_DRIVE_ENABLED=true
GOOGLE_CONNECT_DRIVE_FOLDER_IDS=
GOOGLE_CONNECT_DRIVE_QUERY=
GOOGLE_CONNECT_DRIVE_INCLUDE_MIME_TYPES=application/vnd.google-apps.document,text/plain,text/markdown,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
GOOGLE_CONNECT_DRIVE_PAGE_SIZE=100
GOOGLE_CONNECT_KEEP_ENABLED=false
GOOGLE_CONNECT_KEEP_PAGE_SIZE=50
GOOGLE_CONNECT_KEEP_INCLUDE_TRASHED=false
GOOGLE_CONNECT_TASKS_ENABLED=true
GOOGLE_CONNECT_TASKS_TASKLIST_FILTER=
GOOGLE_CONNECT_TASKS_DEFAULT_TASKLIST=
GOOGLE_CONNECT_TASKS_PAGE_SIZE=100
GOOGLE_CONNECT_STATE_DIR=state
GOOGLE_CONNECT_LOG_DIR=logs
GOOGLE_CONNECT_LOOKBACK_DAYS=30
GOOGLE_CONNECT_MAX_MESSAGES=250
GOOGLE_CONNECT_EXTRACTION_MODE=hybrid_llm_validated
GOOGLE_CONNECT_SOURCE_OWNER=
GOOGLE_CONNECT_ENABLE_WRITES=false
GOOGLE_CONNECT_ENABLE_GMAIL_DRAFTS=false
GOOGLE_CONNECT_ENABLE_CALENDAR_WRITES=false
GOOGLE_CONNECT_ENABLE_CALENDAR_DELETE=false
GOOGLE_CONNECT_ENABLE_SHEETS_WRITES=false
GOOGLE_CONNECT_ENABLE_TASKS_WRITES=false
GOOGLE_CONNECT_WRITABLE_TASKLISTS=
GOOGLE_CONNECT_WRITABLE_CALENDARS=
GOOGLE_CONNECT_WRITABLE_SPREADSHEETS=
